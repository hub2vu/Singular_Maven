{
  "name": "dcinside-maven-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "tsx src/backend/server.ts",
    "start:backend": "node dist/backend/server.js",
    "ingest": "tsx src/backend/cli/ingest.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:extension": "node scripts/smoke-extension-real.mjs",
    "smoke:native-autostart": "node scripts/smoke-native-autostart.mjs",
    "install:native-host": "node scripts/install-native-host.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.2",
    "openai-oauth": "^1.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
