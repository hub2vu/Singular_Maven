# Backend
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
POLICY_JSON_PATH=./dcinside_manager_posts_thesingularity_2026-06-02.json

# OpenAI OAuth local proxy, matching the GPT-img pattern.
# The backend talks to http://127.0.0.1:${OPENAI_OAUTH_PORT}/v1/chat/completions.
# If login is needed, run: npx @openai/codex login
OPENAI_OAUTH_PORT=10531
OPENAI_OAUTH_AUTO_START=1

# API keys and manually pasted bearer tokens are intentionally not used.
# OPENAI_API_KEY is ignored even if present in your environment.

# Model and vision.
OPENAI_MODEL=gpt-5.5
ENABLE_VISION=0

# Development/test only. Leave unset for real moderation review.
MAVEN_ALLOW_MOCK_LLM=0
