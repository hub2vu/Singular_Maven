{
  "manifest_version": 3,
  "name": "DCInside Maven Copilot",
  "version": "0.1.0",
  "description": "Read-only LLM-first moderation copilot for DCInside gallery managers.",
  "key": "",
  "permissions": ["activeTab", "tabs", "sidePanel", "scripting", "storage", "downloads", "nativeMessaging"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://gall.dcinside.com/*",
    "https://*.dcinside.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "DCInside Maven Copilot"
  },
  "content_scripts": [
    {
      "matches": ["https://gall.dcinside.com/*", "https://*.dcinside.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
